-- Dismiss Button for Welcome Screen
local dismissBtn = Instance.new("TextButton")
dismissBtn.Name = "DismissButton"
dismissBtn.Size = UDim2.new(0, 120, 0, 36)
dismissBtn.Position = UDim2.new(0.5, -60, 1, -45)
dismissBtn.BackgroundColor3 = Color3.fromRGB(255, 230, 0)
dismissBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
dismissBtn.Text = "CONTINUE"
dismissBtn.TextSize = 14
dismissBtn.Font = Enum.Font.GothamBold
dismissBtn.Parent = beeWelcomeFrame

local dismissCorner = Instance.new("UICorner")
dismissCorner.CornerRadius = UDim.new(0, 8)
dismissCorner.Parent = dismissBtn

-- Event Connections
beeButton.MouseButton1Click:Connect(function()
    beeWelcomeFrame.Visible = false
    notifFrame.Visible = true
end)

closeBtn.MouseButton1Click:Connect(function()
    notifFrame.Visible = false
    
    -- Show Big BEE Welcome screen after clicking OK
    beeWelcomeFrame.Size = UDim2.new(0, 0, 0, 0)
    beeWelcomeFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    beeWelcomeFrame.Visible = true
    
    -- Pop-in animation effect
    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local tween = TweenService:Create(beeWelcomeFrame, tweenInfo, {
        Size = UDim2.new(0, 380, 0, 240),
        Position = UDim2.new(0.5, -190, 0.5, -120)
    })
    tween:Play()
end)

dismissBtn.MouseButton1Click:Connect(function()
    beeWelcomeFrame.Visible = false
end)

