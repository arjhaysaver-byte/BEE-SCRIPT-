-- Button Creator
local function createButton(name, text, position)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(0.88, 0, 0, 42)
	btn.Position = position
	btn.BackgroundColor3 = Color3.fromRGB(30, 28, 20)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 220, 100)
	btn.TextSize = 14
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = false
	btn.Parent = mainFrame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = btn

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(255, 190, 0)
	btnStroke.Thickness = 1
	btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	btnStroke.Parent = btn

	btn.MouseEnter:Connect(function()
		animate(btn, {BackgroundColor3 = Color3.fromRGB(255, 190, 0), TextColor3 = Color3.fromRGB(15, 15, 15)}, 0.15)
	end)
	
	btn.MouseLeave:Connect(function()
		animate(btn, {BackgroundColor3 = Color3.fromRGB(30, 28, 20), TextColor3 = Color3.fromRGB(255, 220, 100)}, 0.15)
	end)

	return btn
end

