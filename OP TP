-- Helper Function: UI Animation
local function animate(object, properties, time)
	TweenService:Create(object, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties):Play()
end

-- Helper Function: Make Tool Sticky
local function makeToolSticky(character)
	local tool = character:FindFirstChildOfClass("Tool")
	if tool and tool:FindFirstChild("Handle") then
		local handle = tool.Handle
		handle.Massless = true
		handle.CanCollide = false
		
		-- Create welding/attachment safety if physics interfere
		if not handle:FindFirstChild("BeeStickyAttachment") then
			local att0 = Instance.new("Attachment")
			att0.Name = "BeeStickyAttachment"
			att0.Parent = handle

			local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
			if rightHand then
				local att1 = Instance.new("Attachment")
				att1.Name = "BeeStickyHandAttachment"
				att1.Parent = rightHand

				local alignPos = Instance.new("AlignPosition")
				alignPos.Name = "StickyPos"
				alignPos.Mode = Enum.PositionAlignmentMode.TwoAttachment
				alignPos.Attachment0 = att0
				alignPos.Attachment1 = att1
				alignPos.MaxForce = 999999
				alignPos.Responsiveness = 200
				alignPos.Parent = handle
			end
		end
	end
end

-- Helper Function: Spawn Teleport Visual Burst
local function playTeleportEffect(cframe)
	local part = Instance.new("Part")
	part.Size = Vector3.new(1, 1, 1)
	part.CFrame = cframe
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.Parent = workspace

	local attachment = Instance.new("Attachment", part)

	local particles = Instance.new("ParticleEmitter")
	particles.Texture = "rbxassetid://243660364"
	particles.Color = ColorSequence.new(Color3.fromRGB(255, 220, 0))
	particles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 3),
		NumberSequenceKeypoint.new(1, 0)
	})
	particles.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1)
	})
	particles.Lifetime = NumberRange.new(0.5, 0.8)
	particles.Rate = 100
	particles.Speed = NumberRange.new(10, 20)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Parent = attachment

	particles:Emit(50)

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://2865227271"
	sound.Volume = 1
	sound.Parent = SoundService
	sound:Play()

	game:GetService("Debris"):AddItem(part, 1.5)
	game:GetService("Debris"):AddItem(sound, 2)
end

-- Helper Function: Create 3D Visual Bee Marker
local function spawnBeeVisual(cframe)
	if currentBeeModel then
		currentBeeModel:Destroy()
	end

	local beeModel = Instance.new("Model")
	beeModel.Name = "BeeSaveMarker"

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(1.8, 1.8, 2.5)
	body.Shape = Enum.PartType.Ball
	body.Color = Color3.fromRGB(255, 200, 0)
	body.Material = Enum.Material.Neon
	body.Anchored = true
	body.CanCollide = false
	body.CFrame = cframe * CFrame.new(0, 3.5, 0)
	body.Parent = beeModel

	for i = -1, 1, 2 do
		local stripe = Instance.new("Part")
		stripe.Size = Vector3.new(1.85, 1.85, 0.4)
		stripe.Shape = Enum.PartType.Cylinder
		stripe.Color = Color3.fromRGB(20, 20, 20)
		stripe.Material = Enum.Material.SmoothPlastic
		stripe.Anchored = true
		stripe.CanCollide = false
		stripe.CFrame = body.CFrame * CFrame.new(0, 0, i * 0.5) * CFrame.Angles(0, math.rad(90), 0)
		stripe.Parent = beeModel
	end

	local function createWing(xOffset)
		local wing = Instance.new("Part")
		wing.Size = Vector3.new(1.2, 0.1, 1.8)
		wing.Color = Color3.fromRGB(220, 245, 255)
		wing.Material = Enum.Material.Glass
		wing.Transparency = 0.3
		wing.Anchored = true
		wing.CanCollide = false
		wing.CFrame = body.CFrame * CFrame.new(xOffset, 0.9, 0) * CFrame.Angles(math.rad(15), 0, math.rad(xOffset > 0 and 20 or -20))
		wing.Parent = beeModel
	end
	createWing(0.9)
	createWing(-0.9)

	local eyeLeft = Instance.new("Part")
	eyeLeft.Size = Vector3.new(0.4, 0.4, 0.4)
	eyeLeft.Shape = Enum.PartType.Ball
	eyeLeft.Color = Color3.fromRGB(10, 10, 10)
	eyeLeft.Anchored = true
	eyeLeft.CanCollide = false
	eyeLeft.CFrame = body.CFrame * CFrame.new(0.5, 0.3, -1.1)
	eyeLeft.Parent = beeModel

	local eyeRight = eyeLeft:Clone()
	eyeRight.CFrame = body.CFrame * CFrame.new(-0.5, 0.3, -1.1)
	eyeRight.Parent = beeModel

	beeModel.PrimaryPart = body
	beeModel.Parent = workspace
	currentBeeModel = beeModel

	task.spawn(function()
		local startTime = tick()
		local baseCFrame = body.CFrame
		while beeModel and beeModel.Parent do
			local elapsed = tick() - startTime
			local bobbing = math.sin(elapsed * 4) * 0.5
			local rotation = elapsed * 2
			
			local newCFrame = baseCFrame * CFrame.new(0, bobbing, 0) * CFrame.Angles(0, rotation, 0)
			body.CFrame = newCFrame
			eyeLeft.CFrame = newCFrame * CFrame.new(0.5, 0.3, -1.1)
			eyeRight.CFrame = newCFrame * CFrame.new(-0.5, 0.3, -1.1)
			
			task.wait()
		end
	end)
end

