end)

-- Clear/Smooth Teleport Action
tpButton.MouseButton1Click:Connect(function()
	if isTeleporting then return end
	
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	
	if savedCFrame and hrp then
		isTeleporting = true
		
		makeToolSticky(character)
		playTeleportEffect(hrp.CFrame)

		-- Temporarily turn off collisions on character parts for zero glitching/clipping
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end

		local startCFrame = hrp.CFrame
		local duration = 0.8
		local elapsed = 0

		-- Frame-rate independent smooth interpolation (RenderStepped)
		local connection
		connection = RunService.RenderStepped:Connect(function(deltaTime)
			elapsed = elapsed + deltaTime
			local alpha = math.clamp(elapsed / duration, 0, 1)
			
			-- Smooth cubic easing calculation
			local smoothAlpha = math.sin(alpha * math.pi / 2)
			
			hrp.CFrame = startCFrame:Lerp(savedCFrame, smoothAlpha)
			
			if alpha >= 1 then
				connection:Disconnect()
				
				-- Restore normal physics
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") and part.Name == "HumanoidRootPart" then
						part.CanCollide = true
					end
				end
				
				isTeleporting = false
				playTeleportEffect(savedCFrame)

				StarterGui:SetCore("SendNotification", {
					Title = "BEE HUB 🐝",
					Text = "Ang Bubuyog ay muling bumalik🐝",
					Duration = 4
				})

				statusLabel.Text = "STATUS: TELEPORTED!"
				statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
				
				task.delay(2, function()
					statusLabel.Text = "STATUS: READY"
					statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
				end)
			end
		end)
	else
		statusLabel.Text = "STATUS: NO SAVED POSITION!"
		statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		
		task.delay(2, function()
			statusLabel.Text = "STATUS: READY"
			statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
		end)
	end
end)

